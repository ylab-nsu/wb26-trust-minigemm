intros.
apply Q_matrixresult_step.
  - lia.
  - replace (- (1) + (1 + i3))%Z with i3 by lia.
    exact H26.
  - replace (- (1) + (1 + i3))%Z with i3 by lia.
    
    (* ВНЕШНЯЯ ЛЕММА КАДРА (ДЛЯ МАТРИЦЫ) *)
    assert (Hframe_mat: forall k, (k <= i3)%Z -> 
        P_MatrixResult a6 a a1 a2 k i i2 i1 -> 
        P_MatrixResult a9 a a1 a2 k i i2 i1).
    {
      intros k Hk Hmat.
      remember a6 as Mf32.
      
      (* Защищаем наши переменные от переименования при индукции! *)
      remember a as A_. remember a1 as B_. remember a2 as C_.
      remember i as K_. remember i2 as N_. remember i1 as M_.
      
      induction Hmat.
      + subst. apply Q_matrixresult_empty. lia.
      + subst.
        apply Q_matrixresult_step.
        * lia.
        * (* ================= ВНУТРЕННЯЯ ЛЕММА КАДРА (ДЛЯ СТРОКИ) ================= *)
          assert (Hframe_row: forall c, (c <= i2)%Z ->
              P_RowResult a6 a a1 a2 c (- (1) + to)%Z i i2 ->
              P_RowResult a9 a a1 a2 c (- (1) + to)%Z i i2).
          {
            intros c Hc Hrow.
            
            (* Запоминаем индекс строки, чтобы nia его не потеряла *)
            remember (- (1) + to)%Z as i_row eqn:Heq_i_row.
            
            (* Снова защищаем переменные *)
            remember a as A__. remember a1 as B__. remember a2 as C__.
            remember i as K__. remember i2 as N__. 
            
            induction Hrow.
            -- subst. apply Q_rowresult_empty. lia.
            -- subst.
               apply Q_rowresult_step.
               ++ lia.
               ++ apply IHHrow; try assumption; try lia; try reflexivity.
               ++ 
                  (* ================= ЛЕММА КАДРА ДЛЯ СКАЛЯРНОГО ПРОИЗВЕДЕНИЯ ================= *)
                  (* Добавлена граница (k_dot <= i) *)
                  assert (Hframe_dot2: forall k_dot res_, (k_dot <= i)%Z ->
                      P_DotProduction Mf32 a a1 k_dot (- (1) + to)%Z i (- (1) + to0)%Z i2 res_ -> 
                      P_DotProduction a9 a a1 k_dot (- (1) + to)%Z i (- (1) + to0)%Z i2 res_).
                  {
                    intros k_dot res_ Hk_max Hdot_k.
                    remember a9 as Mf32_new.
                        remember (- (1) + to)%Z as row_idx eqn:Heq_row.
    remember (- (1) + to0)%Z as col_idx eqn:Heq_col.
                    
                    induction Hdot_k.
                    ** subst. apply Q_dotproduction_empty_range. lia.
                    ** subst.
                       
                       match goal with
                       | |- context [ Mf32 (shift a ?idxA) ] =>
                         assert (Eq_Cell_A: a9 (shift a idxA) = Mf32 (shift a idxA))
                       end.
                       {
                         unfold a9, a7, x3.
                         match goal with |- _ ?addrA = _ =>
                           (* ИСПРАВЛЕННЫЙ ПОРЯДОК: t2, Mf32, Читаемый_Адрес, Изменяемый_Адрес, Размер *)
                           destruct (havoc_access t2 Mf32 addrA (shift a2 (i7 * i3)%Z) i7) as [Hacc _]
                         end.
                         rewrite Hacc; [reflexivity |].
                         destruct a as [b_a o_a]; destruct a2 as [b_a2 o_a2].
                         unfold separated, shift, base, offset, a4, a5, x1, x2 in *.
                         destruct H19 as [Hb1|[Hb2|[Hb3|[Hb4|Hb5]]]]; try nia.
                         --- right. right. left. exact Hb3.
                        ---right. right. right. left.
    simpl in Hb4.
    assert (Hint1: (i3 + 1 <= i1)%Z) by nia.
    assert (Hint2: (i7 * i3 + i7 <= i1 * i7)%Z) by nia.
    subst. nia.
                         --- right. right. right. right. 
                          simpl in Hb5. nia.
                       }
                       
                       (* 2. Ячейка матрицы B *)
                        match goal with
                       | |- context [ Mf32 (shift a1 ?idxB) ] =>
                         assert (Eq_Cell_B: a9 (shift a1 idxB) = Mf32 (shift a1 idxB))
                       end.
                       {
                         unfold a9, a7, x3.
                         match goal with |- _ ?addrB = _ =>
                           (* Идеальный порядок аргументов и те же адреса, что в EqA *)
                           destruct (havoc_access t2 Mf32 addrB (shift a2 (i7 * i3)%Z) i7) as [Hacc _]
                         end.
                         rewrite Hacc; [reflexivity |].
                         
                         (* Вскрываем B (a1) и C (a2) *)
                         destruct a1 as [b_a1 o_a1]; destruct a2 as [b_a2 o_a2].
                         unfold separated, shift, base, offset, a3, a5, x, x2 in *.
                         
                         (* Разворачиваем H18 (разделение B и C) *)
                         destruct H18 as [Hb1|[Hb2|[Hb3|[Hb4|Hb5]]]]; try nia.
                         --- right. right. left. exact Hb3.
                         --- right. right. right. left.
                             simpl in Hb4.
                             assert (Hint1: (i3 + 1 <= i1)%Z) by nia.
                             assert (Hint2: (i7 * i3 + i7 <= i1 * i7)%Z) by nia.
                             subst. nia.
                         --- right. right. right. right. 
                             simpl in Hb5. nia.
 }
                       
                       (* Заменяем память в цели *)
                       rewrite <- Eq_Cell_A.
                       rewrite <- Eq_Cell_B.
                       
                       apply Q_dotproduction_positive_range.
                       --- lia.
                       --- apply IHHdot_k; try assumption; try reflexivity; try lia.
                  }

                  (* 4. Доказываем, что ячейка C в нашей старой строке не изменилась *)
                  assert (EqC: a9 (shift a2 (- (1) + to0 + i2 *  (- (1) + to)%Z)%Z) = 
                               Mf32 (shift a2 (- (1) + to0 + i2 *  (- (1) + to)%Z)%Z)).
                  {
                    unfold a9, a7, x3.
                    destruct (havoc_access t2 Mf32 (shift a2 (- (1) + to0 + i2 *  (- (1) + to)%Z)%Z) (shift a2 (i2 * i3)%Z) i2 ) as [Hacc _].
                    rewrite Hacc; [reflexivity |].
                    unfold separated, shift, base, offset.
                    nia. 
                  }
                  
                  (* ================= ФИНАЛЬНАЯ СБОРКА ШАГА СТРОКИ ================= *)
                  rewrite EqC.
                  replace (- (1) + to0)%Z with x4 by lia.
                  
                  (* Применяем лемму для DotProduction. 'try lia' докажет k_dot <= i *)
                  apply Hframe_dot2; try assumption; try lia.
          }
          
          (* Выходим из леммы строки и применяем её *)
          apply Hframe_row.
          ** lia.
          ** assumption.
          
        * (* Завершаем шаг индукции матрицы *)
          apply IHHmat; try assumption; try lia; try reflexivity.
    }

    (* ТЕПЕРЬ APPLY СРАБОТАЕТ НА 100%! *)
    apply Hframe_mat; try assumption; try lia.
