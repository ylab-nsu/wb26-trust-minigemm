intros.
 assert (EqC: a13 (shift a2 (i4 + x3)%Z) = a9 (shift a2 (i4 + x3)%Z)).
  {
    unfold a13, a11, Map.set.
    destruct (why_decidable_eq (shift a2 (i7 + x3)%Z) (shift a2 (i4 + x3)%Z)) as [Heq | Hneq].
    - unfold shift, offset in Heq. injection Heq. 
      lia. (* nia легко докажет абсурд, ведь i7 < i4 *)
    - reflexivity.
  }
  
  (* Сразу заменяем чтение из новой памяти a13 на старую a9 *)
  rewrite EqC.

  (* 2. ГЛОБАЛЬНЫЕ ЛЕММЫ: Доказываем, что матрицы A и B не пострадали от записи в C *)
  assert (EqA: forall idx, (0 <= idx)%Z -> (idx < i * i1)%Z -> a13 (shift a idx) = a9 (shift a idx)).
  {
    intros idx Hidx_min Hidx_max. unfold a13, a11, Map.set.
    destruct (why_decidable_eq (shift a2 (i7 + x3)%Z) (shift a idx)) as [Heq | Hneq]; [|reflexivity].
    unfold shift, base, offset, a4, a5, x1, x2 in *. injection Heq as HeqBase HeqOff.
    destruct H25 as [Hb1|[Hb2|[Hb3|[Hb4|Hb5]]]]; try nia.
    * unfold base, shift in Hb3. unfold base in Hb3. congruence.
    * destruct a2 as [b_a2 o_a2]; destruct a as [b_a o_a]. simpl in *.
      assert (i7 + i2 * i3 < i1 * i2)%Z by nia. unfold x3 in *. nia.
    * destruct a2 as [b_a2 o_a2]; destruct a as[b_a o_a]. simpl in *.  unfold x3 in *. nia.
  }

  assert (EqB: forall idx, (0 <= idx)%Z -> (idx < i * i2)%Z -> a13 (shift a1 idx) = a9 (shift a1 idx)).
  {
    intros idx Hidx_min Hidx_max. unfold a13, a11, Map.set.
    destruct (why_decidable_eq (shift a2 (i7 + x3)%Z) (shift a1 idx)) as [Heq | Hneq]; [|reflexivity].
     unfold shift, base, offset, a3, a5, x, x2 in *. injection Heq as HeqBase  HeqOff.
    destruct H24 as [Hb1|[Hb2|[Hb3|[Hb4|Hb5]]]]; try nia.
    *  unfold base, shift in Hb3. unfold base in Hb3. congruence.
    * destruct a2 as [b_a2 o_a2]; destruct a1 as[b_a1 o_a1]. simpl in *.
      assert (i7 + i2 * i3 < i1 * i2)%Z by nia.  unfold x3 in *. nia.
    * destruct a2 as[b_a2 o_a2]; destruct a1 as [b_a1 o_a1]. simpl in *.  unfold x3 in *. nia.
  }

  (* 3. ЛЕММА КАДРА ДЛЯ DOT_PRODUCTION *)
  assert (Hframe_dot: forall k_dot col res_, 
      (k_dot <= i)%Z -> (0 <= col)%Z -> (col < i2)%Z ->
      P_DotProduction a9 a a1 k_dot i3 i col i2 res_ -> 
      P_DotProduction a13 a a1 k_dot i3 i col i2 res_).
  {
    intros k_dot col res_ Hk_max Hcol_min Hcol_max Hdot_k.
    induction Hdot_k as[to_empty Hempty | to_pos Hpos Hdot_prev IH].
    - apply Q_dotproduction_empty_range. lia.
    - rewrite <- EqA; [|lia|nia].
      rewrite <- EqB.
      apply Q_dotproduction_positive_range. nia. 
      apply IHHdot_k; try assumption. nia. 
      nia. nia.
  }

  (* 4. ФИНАЛЬНЫЙ АККОРД: применяем Лемму Кадра и подставляем гипотезу H35! *)
  apply Hframe_dot.
  - lia. (* Доказываем k_dot <= i (у нас i6 <= i) *)
  - lia. (* Доказываем col >= 0 *)
  - lia. (* Доказываем col < i2 *)
  - apply H35. (* Подставляем готовую гипотезу H35 для старой памяти! *)
    + lia. (* Доказываем i7 <= i4 *)
    + lia. (* Доказываем i4 < i2 *)
