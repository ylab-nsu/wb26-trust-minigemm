    assert (Hframe_mat: forall k, (k <= i3)%Z -> 
        P_MatrixResult a6 a a1 a2 k i i2 i1 -> 
        P_MatrixResult a8 a a1 a2 k i i2 i1).
    {
      remember a6 as Mf32.
      intros k Hk Hmat.
      induction Hmat.
      + apply Q_matrixresult_empty. lia.
      + apply Q_matrixresult_step.
        * lia.
        * (* ================= ВНУТРЕННЯЯ ЛЕММА КАДРА (ДЛЯ СТРОКИ) ================= *)
          assert (Hframe_row: forall c, (c <= N)%Z ->
              P_RowResult Mf32 A B C c (- (1) + to)%Z K N ->
              P_RowResult a8 A B C c (- (1) + to)%Z K N).
          {
            intros c Hc Hrow.
            
            (* Запоминаем индекс строки, чтобы nia его не потеряла *)
            remember (- (1) + to)%Z as i_row eqn:Heq_i_row.
            
            induction Hrow.
            -- apply Q_rowresult_empty. lia.
            -- apply Q_rowresult_step.
               ++ lia.
               ++ apply IHHrow; try assumption; try lia.
               ++ (* ================= МИНИ-ЛЕММЫ ДЛЯ DOT_PRODUCTION ================= *)
               
                  (* 1. Доказываем, что матрица A не изменилась *)
              assert (EqA: forall idx, (0 <= idx)%Z -> (idx < K * M)%Z -> 
               a8 (shift A idx) = Mf32 (shift A idx)).
  {
    intros idx Hidx_min Hidx_max.
    unfold a8, a7, x3.
    destruct (havoc_access t2 Mf32 (shift A idx) (shift C (N * i3)%Z) N) as [Hacc _].
    rewrite Hacc;[reflexivity |].
    
    (* КРИТИЧЕСКИ ВАЖНО: разворачиваем x1, чтобы nia увидела K * M вместо x1 *)
    unfold separated, shift, base, offset, a4, a5, x1, x2 in *.
    
    destruct H19 as [Hb1|[Hb2|[Hb3|[Hb4|Hb5]]]].
    - nia.
    - nia.
    - right. right. left. exact Hb3.
    - right. right. right. left.
      destruct A as [base_A off_A]. destruct C as [base_C off_C]. simpl in *.
      assert (Hint1: (i3 + 1 <= M)%Z) by nia.
      assert (Hint2: (N * i3 + N <= M * N)%Z) by nia.
      nia.
    - right. right. right. right.
      destruct A as [base_A off_A]. destruct C as [base_C off_C]. simpl in *.
      
      (* Теперь nia видит гипотезу Hidx_max (idx < K * M) и легко докажет Шаг 1 *)
      assert (Step1: (idx + 1 <= K * M)%Z) by nia.
      assert (Step2: (off_A + idx + 1 <= off_A + K * M)%Z) by nia.
      
      (* Теперь nia видит (K * M) в гипотезе Hb5 благодаря unfold x1 и легко докажет Шаг 3 *)
      assert (Step3: (off_A + K * M <= off_C)%Z) by nia.
      assert (Step4: (0 <= N * i3)%Z) by nia.
      assert (Step5: (off_C <= off_C + N * i3)%Z) by nia.
      
      nia.
  }
                  
                  (* 2. Доказываем, что матрица B не изменилась *)
                  assert (EqB: forall idx, (0 <= idx)%Z -> a8 (shift B idx) = Mf32 (shift B idx)).
                  {
                    intro idx. unfold a8, a7, x3.
                    destruct (havoc_access t2 Mf32 (shift B idx) (shift C (N * i3)%Z) N) as [Hacc _].
                    rewrite Hacc; [reflexivity |].
                    unfold separated, shift, base, offset, a3, a5, x, x2 in *.
                    destruct H18 as [Hb1|[Hb2|[Hb3|[Hb4|Hb5]]]]; try nia.
                    right. right. left. exact Hb3.
assert (Hint1: (N * i3 + N <= M * N)%Z) by nia.
+right. right. right. left.

destruct B as [base_B off_B].
      destruct C as [base_C off_C].
      simpl in *.
      admit.
 
 +admit.
                  }
                  
                  (* 3. Лемма кадра для скалярного произведения (использует EqA и EqB) *)
                  
                  assert (Hframe_dot: forall k_dot res_, 
                      P_DotProduction Mf32 A B k_dot i K (- (1) + to0)%Z N res_ -> 
                      P_DotProduction a8 A B k_dot i K (- (1) + to0)%Z N res_).
                  {
                    intros k_dot res_ Hdot_k.
                    induction Hdot_k.
                    ** apply Q_dotproduction_empty_range. lia.
                    ** rewrite <- EqA. rewrite <- EqB.
                       apply Q_dotproduction_positive_range.
                       --- lia.
                       --- apply IHHdot_k; try assumption.
                  }

                  (* 4. Доказываем, что ячейка C в нашей старой строке не изменилась *)
                  assert (EqC: a8 (shift C (- (1) + to0 + N * i)%Z) = 
                               Mf32 (shift C (- (1) + to0 + N * i)%Z)).
                  {
                    unfold a8, a7, x3.
                    destruct (havoc_access t2 Mf32 (shift C (- (1) + to0 + N * i)%Z) (shift C (N * i3)%Z) N) as [Hacc _].
                    rewrite Hacc; [reflexivity |].
                    unfold separated, shift, base, offset.
                    right. right. right. right.
                    nia. 
                  }
                  
                  (* ================= ФИНАЛЬНАЯ СБОРКА ШАГА СТРОКИ ================= *)
                  
                  (* Возвращаем реальный индекс (-1+to) в EqC, чтобы он совпал с целью *)
                  rewrite Heq_i_row in EqC.
                  rewrite Heq_i_row.
                  rewrite EqC.
                  
                  (* Возвращаем i_row в саму цель, чтобы она совпала с леммой Hframe_dot *)
                  rewrite <- Heq_i_row.
                  
                  (* Применяем лемму DotProduction и подставляем гипотезу из контекста *)
                  apply Hframe_dot.
                  assumption.
          }
          (* Выходим из леммы строки и применяем её *)
          apply Hframe_row.
          ** lia.
          ** assumption.
        * apply IHHmat; try assumption; try lia.
    }
    

