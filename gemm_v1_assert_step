intros.
  assert (EqA: a9 (shift a (i5 + i * i3)%Z) = a10 (shift a (i5 + i * i3)%Z)).
  {
    unfold a10, a9, a7, x3.
    destruct (havoc_access t3 a6 (shift a (i5 + i * i3)%Z) (shift a2 (i2 * i3)%Z) i2) as [LH1 zxc1].
    destruct (havoc_access t2 a6 (shift a (i5 + i * i3)%Z) (shift a2 (i2 * i3)%Z) i2) as [LH2 zxc2].
    rewrite LH1, LH2.
    - reflexivity.
    - unfold separated, shift, base, offset, a4, a5, x1, x2 in *.
       destruct a as[b_a o_a].
  destruct a2 as [b_a2 o_a2].
      unfold separated, a4, a5, x1, x2, shift, base, offset in *.
  simpl in *.
       destruct H22 as [Hb1 |[Hb2 | [Hb3 | [Hb4 | Hb5]]]].
    
    + (* Ветка 1: Размер A <= 0 *) nia.
    + (* Ветка 2: Размер C <= 0 *) nia.
    + (* Ветка 3: Базовые адреса разные *)
      right. right. left. 
      exact Hb3.
      
    + (* Ветка 4: Матрица C лежит ДО матрицы A *)
      right. right. right. left.
      (* Подсказываем nia, что изменяемая строка C не выходит за конец матрицы C.
         i3 < i1 (строка меньше высоты M), i2 - это ширина N *)
      assert (Hint1: (i3 + 1 <= i1)%Z) by nia.
      assert (Hint2: (i2 * i3 + i2 <= i1 * i2)%Z) by nia.
      nia.
      
    + (* Ветка 5: Матрица A лежит ДО матрицы C *)
      right. right. right. right.
      nia.

       -destruct a as[b_a o_a].
  destruct a2 as [b_a2 o_a2].
      unfold separated, a4, a5, x1, x2, shift, base, offset in *.
  simpl in *.
       destruct H22 as [Hb1 |[Hb2 | [Hb3 | [Hb4 | Hb5]]]]; try nia.

  }
  

  rewrite EqA.


  replace (a10 (shift a1 (i6 + i2 * i5)%Z) * a10 (shift a (i5 + i * i3)%Z) +
           a10 (shift a2 (i6 + x3)%Z))%R
     with (a10 (shift a2 (i6 + x3)%Z) +
           a10 (shift a (i5 + i * i3)%Z) * a10 (shift a1 (i6 + i2 * i5)%Z))%R by ring.
  replace (i5 + i * i3)%Z with (- (1) + x4 + i * i3)%Z by lia.
  replace (i6 + i2 * i5)%Z with (i6 + i2 * (- (1) + x4))%Z by lia.
  replace (i * i3)%Z with (i3 * i)%Z by lia.
  apply Q_dotproduction_positive_range.
  
  -
    lia.
    
  - replace (- (1) + x4)%Z with i5 by lia.
    apply H31.
    + lia.
    + lia. 
